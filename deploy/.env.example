# Copy to deploy/.env and fill in. The password is read only from the
# environment - it is never written to a config file or logged.
#
# Broker credentials for programmatic MT5 login (headless). Leave blank to log
# in manually via the VNC web UI instead (one-time; persists in the volume).
MT5_LOGIN=00000000
MT5_PASSWORD=
MT5_SERVER=Your-Broker-Server

# KasmVNC web-UI auth - the one-time terminal login at http://127.0.0.1:3001.
VNC_USER=mt5
VNC_PASSWORD=change-me

# Symbol the screenshot EA attaches to; must exist on the account
# (for example EURUSD.z on a Zero account). Default: BTCUSD.
MT5_EA_SYMBOL=BTCUSD

# Optional bearer token for the MCP HTTP endpoint. Written to config.toml on
# first boot only; an existing config.toml is never overwritten, so this is
# then ignored, and its [screenshot] section needs template = "agent_light.tpl"
# added by hand. Characters outside [A-Za-z0-9._~+/=-] stop mt5-mcp starting.
MT5_MCP_AUTH_TOKEN=

# Leave MT5_MCP_VERSION unset or empty to use the version pinned in the image;
# setting it here overrides the pin.
# MT5_MCP_VERSION=

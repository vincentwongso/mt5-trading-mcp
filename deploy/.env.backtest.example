# Copy to deploy/.env.backtest and fill in (that file is gitignored).
# The password is read only from the environment, never written to a file.
# Nothing logs in with these automatically in this container (no MCP server):
# log the terminal in once yourself (VNC or the README's fresh-volume steps).
MT5_LOGIN=00000000
MT5_PASSWORD=
MT5_SERVER=Your-Broker-Server

# Host folder for sources, .set files and results; mounted at the same path.
MT5_WORK_DIR=/home/you/mt5-work

# Your host uid/gid (`id -u`, `id -g`), so files in MT5_WORK_DIR are yours.
PUID=1000
PGID=1000

# CPUs the container (and so the tester's agents) may use, e.g. 0-11 on a
# 16-CPU host to leave 4 for a live container. Must exist on this host;
# leave empty for all CPUs.
BT_CPUSET=

# A symbol on the account, for the terminal's startup chart.
MT5_EA_SYMBOL=EURUSD

# KasmVNC web UI for the one-time login.
VNC_PORT=3006
VNC_USER=mt5
VNC_PASSWORD=change-me
